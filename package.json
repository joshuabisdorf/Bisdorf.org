{
  "name": "bisdorf-org",
  "description": "Personal website for Joshua Bisdorf.",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preflight": "node scripts/repo_preflight.mjs",
    "preflight:history": "node scripts/repo_preflight.mjs --history",
    "verify:site": "node scripts/site_integrity.mjs",
    "check": "npm run format:check && npm run preflight && npm run build && npm run verify:site"
  },
  "keywords": [
    "portfolio",
    "personal-website",
    "astro",
    "computer-science"
  ],
  "author": "Joshua Bisdorf",
  "license": "Apache-2.0",
  "dependencies": {
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0"
  }
}
